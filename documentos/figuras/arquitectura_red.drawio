<mxfile host="drawio" agent="generador local"><diagram id="arq" name="Arquitectura red funcional"><mxGraphModel dx="900" dy="840" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="760" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ent" value="&lt;b style=&quot;font-size:15px&quot;&gt;1. Entrada&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;Curva satelital X(t)&lt;br&gt;X(t) = φ(t)&lt;sup&gt;T&lt;/sup&gt;c&lt;br&gt;B-spline cúbica, K&lt;sub&gt;X&lt;/sub&gt; = 11&lt;br&gt;c: 11 coeficientes&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;X en escala √ (mm/día, 72 péntadas)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#E3EDF8;strokeColor=#5B7DB1;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="250" height="150" as="geometry"/></mxCell><mxCell id="cod" value="&lt;b style=&quot;font-size:15px&quot;&gt;2. Codificador funcional&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;6 neuronas funcionales, k = 1, …, 6&lt;br&gt;z&lt;sub&gt;k&lt;/sub&gt; = ∫ w&lt;sub&gt;k&lt;/sub&gt;(t) X(t) dt = a&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; W c&lt;br&gt;w&lt;sub&gt;k&lt;/sub&gt;(t) = φ(t)&lt;sup&gt;T&lt;/sup&gt;a&lt;sub&gt;k&lt;/sub&gt;&lt;br&gt;&lt;b&gt;66 parámetros&lt;/b&gt; (A: 6 × 11)&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;W = ∫ φ φ&lt;sup&gt;T&lt;/sup&gt; dt: matriz de Gram, fija&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#FFF4D6;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="310" y="20" width="300" height="150" as="geometry"/></mxCell><mxCell id="cat" value="&lt;b style=&quot;font-size:15px&quot;&gt;3. Concatenación&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;x = (z&lt;sub&gt;1&lt;/sub&gt;, …, z&lt;sub&gt;6&lt;/sub&gt;, altitud, ONI)&lt;br&gt;&lt;b&gt;8 entradas&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;altitud estandarizada con media y DE del entrenamiento&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;ONI: media anual, sin escalar&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#E3EDF8;strokeColor=#5B7DB1;" vertex="1" parent="1"><mxGeometry x="650" y="20" width="230" height="150" as="geometry"/></mxCell><mxCell id="cab" value="&lt;b style=&quot;font-size:15px&quot;&gt;4. Cabeza intercambiable&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:13px&quot;&gt;(se entrena una de las tres; mismo codificador y mismo decodificador)&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#FFFFFF;strokeColor=#8C8C8C;dashed=1;dashPattern=6 4;align=left;spacingLeft=12;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="860" height="232" as="geometry"/></mxCell><mxCell id="lin" value="&lt;b style=&quot;font-size:15px&quot;&gt;Lineal&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;s&lt;sub&gt;m&lt;/sub&gt; = β&lt;sub&gt;m0&lt;/sub&gt; + Σ&lt;sub&gt;i&lt;/sub&gt; β&lt;sub&gt;mi&lt;/sub&gt; x&lt;sub&gt;i&lt;/sub&gt;&lt;br&gt;8 → 5&lt;br&gt;&lt;b&gt;45 parámetros&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;40 pesos + 5 sesgos&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;total con codificador: 111&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#FFF4D6;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="35" y="248" width="220" height="180" as="geometry"/></mxCell><mxCell id="mlp" value="&lt;b style=&quot;font-size:15px&quot;&gt;MLP&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;8 → 32 → 5&lt;br&gt;activación GELU&lt;br&gt;&lt;b&gt;453 parámetros&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;(8·32 + 32) + (32·5 + 5)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;total con codificador: 519&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#FFF4D6;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="270" y="248" width="220" height="180" as="geometry"/></mxCell><mxCell id="kan" value="&lt;b style=&quot;font-size:15px&quot;&gt;KAN aditiva&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;s&lt;sub&gt;m&lt;/sub&gt; = Σ&lt;sub&gt;i&lt;/sub&gt; φ&lt;sub&gt;mi&lt;/sub&gt;(x&lt;sub&gt;i&lt;/sub&gt;), una arista por par (i, m)&lt;br&gt;φ(x) = w&lt;sub&gt;b&lt;/sub&gt;·SiLU(x) + Σ&lt;sub&gt;g&lt;/sub&gt; c&lt;sub&gt;g&lt;/sub&gt;·exp(−((x − μ&lt;sub&gt;g&lt;/sub&gt;)/h)&lt;sup&gt;2&lt;/sup&gt;)&lt;br&gt;G = 10 gaussianas, μ&lt;sub&gt;g&lt;/sub&gt; en [−2, 2], h = 4/9&lt;br&gt;&lt;b&gt;440 parámetros&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;40 aristas: 40 w&lt;sub&gt;b&lt;/sub&gt; + 400 c&lt;sub&gt;g&lt;/sub&gt;; total con codificador: 506&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;cada x&lt;sub&gt;i&lt;/sub&gt; normalizada por variable (media y varianza del entrenamiento)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#FFF4D6;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="505" y="248" width="360" height="180" as="geometry"/></mxCell><mxCell id="sal" value="&lt;b style=&quot;font-size:15px&quot;&gt;5. Salida de la cabeza&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;s = (s&lt;sub&gt;1&lt;/sub&gt;, …, s&lt;sub&gt;5&lt;/sub&gt;)&lt;br&gt;M = 5 puntajes FPCA&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;coordenadas en la base de autofunciones&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#E3EDF8;strokeColor=#5B7DB1;" vertex="1" parent="1"><mxGeometry x="20" y="482" width="250" height="122" as="geometry"/></mxCell><mxCell id="dec" value="&lt;b style=&quot;font-size:15px&quot;&gt;6. Decodificador FPCA congelado&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;ŷ(t) = μ(t) + Σ&lt;sub&gt;m=1..5&lt;/sub&gt; s&lt;sub&gt;m&lt;/sub&gt; ψ&lt;sub&gt;m&lt;/sub&gt;(t)&lt;br&gt;escala √P, 0 parámetros entrenables&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;μ y ψ&lt;sub&gt;m&lt;/sub&gt;: FPCA de las curvas de entrenamiento&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;en la base B-spline de la estación (K&lt;sub&gt;Y&lt;/sub&gt; = 8)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#EDEDED;strokeColor=#8C8C8C;" vertex="1" parent="1"><mxGeometry x="310" y="482" width="300" height="122" as="geometry"/></mxCell><mxCell id="mm" value="&lt;b style=&quot;font-size:15px&quot;&gt;7. Vuelta a mm/día&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;margin-top:5px&quot;&gt;P̂(t) = max(ŷ(t), 0)&lt;sup&gt;2&lt;/sup&gt; + σ&lt;sup&gt;2&lt;/sup&gt;(t)&lt;br&gt;no negativa&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;σ&lt;sup&gt;2&lt;/sup&gt;(t): varianza residual en escala √ del entrenamiento&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#E3EDF8;strokeColor=#5B7DB1;" vertex="1" parent="1"><mxGeometry x="650" y="482" width="230" height="122" as="geometry"/></mxCell><mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#3C3C3C;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ent" target="cod"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#3C3C3C;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cod" target="cat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#3C3C3C;strokeWidth=1.6;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8662790697674418;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cat" target="cab"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#3C3C3C;strokeWidth=1.6;exitX=0.145;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cab" target="sal"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#3C3C3C;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sal" target="dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#3C3C3C;strokeWidth=1.6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dec" target="mm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="perd" value="&lt;b&gt;Pérdida de entrenamiento.&lt;/b&gt; &amp;nbsp;L = (ĉ − c)&lt;sup&gt;T&lt;/sup&gt; W&lt;sub&gt;Y&lt;/sub&gt; (ĉ − c) + λ&lt;sub&gt;w&lt;/sub&gt; Σ&lt;sub&gt;k&lt;/sub&gt; a&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;T&lt;/sup&gt; R a&lt;sub&gt;k&lt;/sub&gt;&amp;nbsp;&amp;nbsp;+ λ&lt;sub&gt;1&lt;/sub&gt; (L1 + 2 · entropía), solo en la KAN, para la poda.&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#555555&quot;&gt;ĉ y c: coeficientes de la curva predicha y la observada en escala √ (base de la estación, K&lt;sub&gt;Y&lt;/sub&gt; = 8); W&lt;sub&gt;Y&lt;/sub&gt;: su matriz de Gram; R = ∫ φ″ φ″&lt;sup&gt;T&lt;/sup&gt; dt: rugosidad de los pesos w&lt;sub&gt;k&lt;/sub&gt;; L1 de los c&lt;sub&gt;g&lt;/sub&gt; y entropía de las magnitudes de las aristas; la poda retira las aristas con amplitud menor al 10 % de la mayor. Valores finales: λ&lt;sub&gt;w&lt;/sub&gt; = 0,01 (lineal y KAN) y 0,1 (MLP); λ&lt;sub&gt;1&lt;/sub&gt; = 0,01.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=14;fontColor=#222222;verticalAlign=top;align=center;spacingTop=6;spacingLeft=6;spacingRight=6;strokeWidth=1.3;fillColor=#FFFFFF;strokeColor=#B5B5B5;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;arcSize=4;" vertex="1" parent="1"><mxGeometry x="20" y="634" width="860" height="86" as="geometry"/></mxCell><mxCell id="ley0" value="" style="rounded=1;arcSize=10;html=1;strokeWidth=1.3;fillColor=#E3EDF8;strokeColor=#5B7DB1;" vertex="1" parent="1"><mxGeometry x="520" y="736" width="22" height="14" as="geometry"/></mxCell><mxCell id="leyt0" value="datos" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="548" y="732" width="95" height="22" as="geometry"/></mxCell><mxCell id="ley1" value="" style="rounded=1;arcSize=10;html=1;strokeWidth=1.3;fillColor=#FFF4D6;strokeColor=#C9A227;" vertex="1" parent="1"><mxGeometry x="645" y="736" width="22" height="14" as="geometry"/></mxCell><mxCell id="leyt1" value="entrenable" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="673" y="732" width="95" height="22" as="geometry"/></mxCell><mxCell id="ley2" value="" style="rounded=1;arcSize=10;html=1;strokeWidth=1.3;fillColor=#EDEDED;strokeColor=#8C8C8C;" vertex="1" parent="1"><mxGeometry x="770" y="736" width="22" height="14" as="geometry"/></mxCell><mxCell id="leyt2" value="congelado" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#222222;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="798" y="732" width="95" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>